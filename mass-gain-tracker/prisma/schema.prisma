datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String      @id @default(uuid())
  weights   WeightLog[]
}

model WeightLog {
  id             String   @id @default(uuid())
  date           DateTime @unique
  weight         Float
  weekly_average Float?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

model DailyPlan {
  date         DateTime   @id
  dayNumber    Int
  phase        String
  type         String
  baseCalories Int
  isCompleted  Boolean    @default(false)
  meals        Meal[]
  exercises    Exercise[]
}

model Meal {
  id          String    @id @default(uuid())
  time        String
  name        String
  calories    Int
  items       String
  isCompleted Boolean   @default(false)
  dailyPlanId DateTime
  dailyPlan   DailyPlan @relation(fields: [dailyPlanId], references: [date])
}

model Exercise {
  id          String    @id @default(uuid())
  order       Int
  name        String
  sets        Int
  reps        String
  weight      String
  isCompleted Boolean   @default(false)
  dailyPlanId DateTime
  dailyPlan   DailyPlan @relation(fields: [dailyPlanId], references: [date])
}
